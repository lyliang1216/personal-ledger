# NestJS 运行时连接；使用应用侧连接池或 Transaction Pooler。
DATABASE_URL="postgresql://postgres:postgres@localhost:6543/personal_ledger"

# Prisma CLI、migration 与 seed 连接；使用直连或 Session Pooler。
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/personal_ledger"

# JWT Access Token 配置。JWT_SECRET 必须在本地或部署环境中提供真实随机值。
JWT_SECRET=
JWT_EXPIRES_IN=1d

# 仅供 seed 创建开发管理员密码，禁止提交真实密码。
SEED_ADMIN_PASSWORD=

# 允许访问 API 的 PC Admin 地址。
ADMIN_ORIGIN=http://localhost:5173
